# One-time administration activation. Generate a long random value; keep it secret.
OWNER_ACTIVATION_TOKEN=

# Where the server stores the SQLite database and uploaded product images.
# Point these at a persistent volume in production (see docker-compose.yml).
DB_PATH=./data/dook.sqlite
MEDIA_PATH=./data/media

# How long a login session stays valid.
SESSION_MAX_AGE_DAYS=30

# SMTP for order-confirmation and password-reset emails. Leave SMTP_HOST empty
# to skip sending email (order confirmation stays screen-only, and password
# resets must then be done manually).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Leave empty to keep analytics
# off entirely — visitors then never see a cookie banner. Even when set, the script
# only loads after a visitor accepts cookies (see the consent banner in public/app.js).
GA_MEASUREMENT_ID=

PORT=3000
