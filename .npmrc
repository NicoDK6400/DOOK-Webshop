# Stop npm from auto-installing optional PEER dependencies (npm 7+ feature).
# drizzle-orm/drizzle-kit list several optional database drivers
# (better-sqlite3, pg, mysql2, ...) as optional peer deps for features this
# project doesn't use; better-sqlite3 needs a native build toolchain on
# platforms without a prebuilt binary. This does NOT affect real
# optionalDependencies entries (like Vite/Rollup's per-platform native
# binaries), which still install normally.
legacy-peer-deps=true
